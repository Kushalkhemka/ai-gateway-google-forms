{
  "manifest_version": 3,
  "name": "AI Gateway",
  "version": "1.1.1",
  "description": "Autofill Google Forms and NPTEL assessments, with NPTEL copy and paste support.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://onlinecourses.nptel.ac.in/*",
    "https://storage.googleapis.com/*",
    "https://ai-gateway.vercel.sh/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AI Gateway",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nptel.ac.in/*",
        "https://*.nptel.ac.in/*"
      ],
      "js": ["nptel-clipboard.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://docs.google.com/forms/*",
        "https://onlinecourses.nptel.ac.in/e-learning/course/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
